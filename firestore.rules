rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'admin';
    }

    function esSupervisor(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'supervisor';
    }

    function esAdminOSupervisor(uid) {
      let rol = get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
      return rol == 'admin' || rol == 'supervisor';
    }

    function rolActivo(uid) {
      let rol = get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
      return rol == 'admin' || rol == 'supervisor' || rol == 'afiliador';
    }

    function emailUsuario(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.email;
    }

    function estadoPendiente(data) {
      return !('estadoControl' in data) || data.estadoControl == 'pendiente';
    }

    function conservaEstadoPendiente() {
      return (
        !('estadoControl' in resource.data) &&
        (!('estadoControl' in request.resource.data) || request.resource.data.estadoControl == 'pendiente')
      ) || (
        ('estadoControl' in resource.data) &&
        request.resource.data.estadoControl == resource.data.estadoControl
      );
    }

    function usuarioInicialValido(uid) {
      return request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'nombre', 'apellido', 'rol', 'perfilCompleto', 'fechaRegistro']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.nombre == '' &&
        request.resource.data.apellido == '' &&
        request.resource.data.rol == 'pendiente' &&
        request.resource.data.perfilCompleto == false;
    }

    function actualizacionPerfilPropioValida(uid) {
      return request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido', 'perfilCompleto']) &&
        request.resource.data.rol == resource.data.rol &&
        request.resource.data.email == resource.data.email;
    }

    function actualizacionSupervisorValida() {
      return esSupervisor(request.auth.uid) &&
        resource.data.rol != 'admin' &&
        resource.data.rol != 'supervisor' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido', 'rol']) &&
        (request.resource.data.rol == resource.data.rol || request.resource.data.rol == 'afiliador') &&
        request.resource.data.email == resource.data.email;
    }

    function camposCreacionFicha() {
      return [
        'tipoDocumento', 'dni', 'apellidos', 'nombres', 'sexo', 'clase',
        'fechaNacimiento', 'lugarNacimiento', 'nacionalidad', 'profesion',
        'estadoCivil', 'celular', 'mail', 'distrito', 'calle', 'numero',
        'piso', 'dpto', 'localidad', 'observaciones', 'estadoControl',
        'archivoDni', 'archivoDniPath', 'afiliadorNombre', 'afiliadorEmail',
        'afiliadorUid', 'fecha', 'origen', 'linkToken'
      ];
    }

    function camposEditablesFichaPendiente() {
      return [
        'id', 'apellidos', 'nombres', 'sexo', 'clase',
        'fechaNacimiento', 'lugarNacimiento', 'nacionalidad', 'profesion',
        'estadoCivil', 'celular', 'mail', 'distrito', 'calle', 'numero',
        'piso', 'dpto', 'localidad', 'observaciones', 'estadoControl',
        'archivoDni', 'archivoDniPath', 'ultimaModificacion'
      ];
    }

    function indiceDniValido(docId) {
      let indice = getAfter(/databases/$(database)/documents/dniIndex/$(request.resource.data.dni)).data;
      return indice.fichaId == docId &&
        indice.dni == request.resource.data.dni &&
        indice.afiliadorUid == request.auth.uid;
    }

    function creacionFichaValida(docId) {
      return rolActivo(request.auth.uid) &&
        request.resource.data.keys().hasOnly(camposCreacionFicha()) &&
        request.resource.data.afiliadorUid == request.auth.uid &&
        request.resource.data.afiliadorEmail == emailUsuario(request.auth.uid) &&
        (!('origen' in request.resource.data) || request.resource.data.origen == 'app') &&
        !('linkToken' in request.resource.data) &&
        estadoPendiente(request.resource.data) &&
        indiceDniValido(docId);
    }

    function linkPublicoUsadoValido(token, docId) {
      let link = getAfter(/databases/$(database)/documents/linksCargaPublica/$(token)).data;
      return link.usado == true &&
        link.fichaId == docId &&
        link.dni == request.resource.data.dni &&
        link.venceEn > request.time &&
        link.afiliadorUid == request.resource.data.afiliadorUid &&
        link.afiliadorEmail == request.resource.data.afiliadorEmail;
    }

    function indiceDniPublicoValido(docId, token) {
      let indice = getAfter(/databases/$(database)/documents/dniIndex/$(request.resource.data.dni)).data;
      return indice.fichaId == docId &&
        indice.dni == request.resource.data.dni &&
        indice.afiliadorUid == request.resource.data.afiliadorUid &&
        linkPublicoUsadoValido(token, docId);
    }

    function creacionFichaPublicaValida(docId) {
      let token = request.resource.data.linkToken;
      return request.auth == null &&
        request.resource.data.keys().hasOnly(camposCreacionFicha()) &&
        request.resource.data.origen == 'link_publico' &&
        token is string &&
        request.resource.data.archivoDniPath.matches('dnisPublicos/' + token + '/.*') &&
        estadoPendiente(request.resource.data) &&
        linkPublicoUsadoValido(token, docId) &&
        indiceDniPublicoValido(docId, token);
    }

    function usoLinkPublicoValido(token) {
      let ficha = getAfter(/databases/$(database)/documents/afiliaciones/$(request.resource.data.fichaId)).data;
      return request.auth == null &&
        resource.data.usado == false &&
        resource.data.venceEn > request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usadoEn', 'fichaId', 'dni']) &&
        request.resource.data.usado == true &&
        request.resource.data.afiliadorUid == resource.data.afiliadorUid &&
        request.resource.data.afiliadorEmail == resource.data.afiliadorEmail &&
        request.resource.data.afiliadorNombre == resource.data.afiliadorNombre &&
        request.resource.data.creadoEn == resource.data.creadoEn &&
        request.resource.data.venceEn == resource.data.venceEn &&
        ficha.linkToken == token &&
        ficha.dni == request.resource.data.dni &&
        ficha.afiliadorUid == resource.data.afiliadorUid;
    }

    function eliminacionIndiceDniValida(dni) {
      let fichaPath = /databases/$(database)/documents/afiliaciones/$(resource.data.fichaId);
      let ficha = get(fichaPath).data;
      return (
        esAdmin(request.auth.uid) ||
        ((esSupervisor(request.auth.uid) || resource.data.afiliadorUid == request.auth.uid) && estadoPendiente(ficha))
      ) &&
      resource.data.dni == dni &&
      !existsAfter(fichaPath);
    }

    function conservaPropiedadFicha() {
      return request.resource.data.afiliadorUid == resource.data.afiliadorUid &&
        request.resource.data.afiliadorEmail == resource.data.afiliadorEmail &&
        request.resource.data.fecha == resource.data.fecha;
    }

    function actualizacionFichaPendienteValida() {
      return (resource.data.afiliadorUid == request.auth.uid || esSupervisor(request.auth.uid)) &&
        estadoPendiente(resource.data) &&
        conservaEstadoPendiente() &&
        conservaPropiedadFicha() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposEditablesFichaPendiente());
    }

    match /usuarios/{uid} {
      // El propio usuario y admins/supervisores pueden leer
      allow read: if request.auth != null &&
        (request.auth.uid == uid || esAdminOSupervisor(request.auth.uid));
      // Un usuario puede crear su propio documento al registrarse, pero siempre pendiente
      allow create: if request.auth != null && usuarioInicialValido(uid);
      // Admin: puede cambiar cualquier campo.
      // Supervisor: puede editar nombre/apellido y aprobar como afiliador (no puede asignar admin/supervisor).
      // El propio usuario: puede actualizar su perfil (nombre, apellido, perfilCompleto) sin cambiar su rol.
      allow update: if request.auth != null && (
        esAdmin(request.auth.uid) ||
        actualizacionSupervisorValida() ||
        actualizacionPerfilPropioValida(uid)
      );
      allow delete: if request.auth != null && esAdmin(request.auth.uid);
    }

    match /dniIndex/{dni} {
      allow read: if request.auth != null && rolActivo(request.auth.uid);
      allow create: if request.auth != null &&
        rolActivo(request.auth.uid) &&
        request.resource.data.keys().hasOnly(['dni', 'fichaId', 'afiliadorUid', 'fecha']) &&
        request.resource.data.dni == dni &&
        request.resource.data.afiliadorUid == request.auth.uid
        ||
        request.auth == null &&
        request.resource.data.keys().hasOnly(['dni', 'fichaId', 'afiliadorUid', 'fecha']) &&
        request.resource.data.dni == dni &&
        existsAfter(/databases/$(database)/documents/afiliaciones/$(request.resource.data.fichaId)) &&
        getAfter(/databases/$(database)/documents/afiliaciones/$(request.resource.data.fichaId)).data.dni == dni &&
        getAfter(/databases/$(database)/documents/afiliaciones/$(request.resource.data.fichaId)).data.afiliadorUid == request.resource.data.afiliadorUid;
      allow update: if false;
      allow delete: if request.auth != null && (
        esAdmin(request.auth.uid) ||
        eliminacionIndiceDniValida(dni)
      );
    }

    match /linksCargaPublica/{token} {
      allow get: if resource.data.usado == false && resource.data.venceEn > request.time;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['afiliadorUid', 'afiliadorEmail', 'afiliadorNombre', 'creadoEn', 'venceEn', 'usado']) &&
        request.resource.data.afiliadorUid == request.auth.uid &&
        request.resource.data.afiliadorEmail is string &&
        request.resource.data.afiliadorNombre is string &&
        request.resource.data.usado == false &&
        request.resource.data.venceEn > request.time;
      allow update: if usoLinkPublicoValido(token);
      allow delete: if false;
    }

    match /afiliaciones/{docId} {
      // El afiliador ve sus propios registros; admins y supervisores ven todo
      allow read: if request.auth != null &&
        (resource.data.afiliadorUid == request.auth.uid || esAdminOSupervisor(request.auth.uid));
      // Solo usuarios activos pueden crear fichas con su propio uid
      allow create: if (request.auth != null && creacionFichaValida(docId)) ||
        creacionFichaPublicaValida(docId);
      // Admin puede editar siempre. Afiliador/supervisor solo mientras la ficha siga en paso 1.
      allow update: if request.auth != null && (
        esAdmin(request.auth.uid) ||
        actualizacionFichaPendienteValida()
      );
      // Admin puede eliminar siempre. Supervisor y afiliador (dueño) solo mientras la ficha siga en paso 1.
      allow delete: if request.auth != null && (
        esAdmin(request.auth.uid) ||
        ((esSupervisor(request.auth.uid) || resource.data.afiliadorUid == request.auth.uid) && estadoPendiente(resource.data))
      );
    }
  }
}
