rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function rolUsuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return request.auth != null && rolUsuario() == 'admin';
    }

    function esSupervisor() {
      return request.auth != null && rolUsuario() == 'supervisor';
    }

    function esAdminOSupervisor() {
      return esAdmin() || esSupervisor();
    }

    function rolActivo() {
      let rol = rolUsuario();
      return rol == 'admin' || rol == 'supervisor' || rol == 'afiliador';
    }

    match /dnisPublicos/{token}/{fileName} {
      allow get: if request.auth != null && (
        esAdminOSupervisor() ||
        firestore.get(/databases/(default)/documents/linksCargaPublica/$(token)).data.afiliadorUid == request.auth.uid
      );
      allow list: if false;
      allow create: if firestore.get(/databases/(default)/documents/linksCargaPublica/$(token)).data.usado == false &&
        firestore.get(/databases/(default)/documents/linksCargaPublica/$(token)).data.get('revocado', false) != true &&
        firestore.get(/databases/(default)/documents/linksCargaPublica/$(token)).data.venceEn > request.time &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow update: if false;
      allow delete: if false;
    }

    match /dnis/{ownerUid}/{fileName} {
      allow get: if request.auth != null &&
        (request.auth.uid == ownerUid || esAdminOSupervisor());
      allow list: if false;
      allow create: if request.auth != null &&
        ((request.auth.uid == ownerUid && rolActivo()) || esAdminOSupervisor()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }

    match /fichas/{docId}/{fileName} {
      allow get: if esAdminOSupervisor();
      allow list: if false;
      allow create: if esAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }

    // Legacy: archivos subidos antes de incluir uid/docId en el path.
    // No tienen owner verificable, por eso quedan solo para admin/supervisor.
    match /dnis/{fileName} {
      allow get: if esAdminOSupervisor();
      allow list: if false;
      allow write: if false;
      allow delete: if esAdmin();
    }
    match /fichas/{fileName} {
      allow get: if esAdminOSupervisor();
      allow list: if false;
      allow write: if false;
      allow delete: if esAdmin();
    }
  }
}
